<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Lista de Produtos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Picker de filtro -->
            <Label Text="Filtrar por Categoria" FontAttributes="Bold"/>
            <Picker x:Name="FiltroCategoriaPicker"
                    Title="Selecione a Categoria"
                    SelectedIndexChanged="OnFiltroCategoriaChanged">
                <Picker.Items>
                    <x:String>Todos</x:String>
                    <x:String>Alimentos</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                    <x:String>Outros</x:String>
                </Picker.Items>
            </Picker>

            <!-- CollectionView com produtos -->
            <CollectionView x:Name="ProdutosCollectionView" HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" Margin="5" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding Descricao}" FontSize="16"/>
                                <Label Text="{Binding Categoria}" FontSize="14" TextColor="Gray"/>
                                <Label Text="{Binding Total, StringFormat='Total: {0:C}'}" FontAttributes="Bold"/>

                                <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                    <Button Text="Editar" Clicked="OnEditarProduto"/>
                                    <Button Text="Excluir" Clicked="OnDeletarProduto" BackgroundColor="Red" TextColor="White"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botões gerais -->
            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <Button Text="Adicionar Produto" Clicked="OnAbrirNovoProduto"/>
                <Button Text="Relatório" Clicked="OnAbrirRelatorio" BackgroundColor="#2196F3" TextColor="White"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>