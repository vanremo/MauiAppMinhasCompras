<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Novo Produto" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

            <!-- Campo Descrição -->
            <Entry x:Name="DescricaoEntry" Placeholder="Descrição do produto"/>

            <!-- Campo Quantidade -->
            <Entry x:Name="QuantidadeEntry" Placeholder="Quantidade" Keyboard="Numeric"/>

            <!-- Campo Preço -->
            <Entry x:Name="PrecoEntry" Placeholder="Preço" Keyboard="Numeric"/>

            <!-- Campo Categoria -->
            <Picker x:Name="CategoriaPicker" Title="Selecione a Categoria">
                <Picker.Items>
                    <x:String>Alimentos</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                    <x:String>Outros</x:String>
                </Picker.Items>
            </Picker>

            <!-- Botão Salvar -->
            <Button Text="Adicionar Produto" Clicked="OnAdicionarProduto"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>