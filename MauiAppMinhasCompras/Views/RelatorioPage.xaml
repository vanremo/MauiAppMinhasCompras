<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioPage"
             Title="Relatório por Categoria">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Resumo de Gastos por Categoria" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

            <CollectionView x:Name="RelatorioCollectionView" HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" Margin="5" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding Categoria}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Total, StringFormat='Total gasto: {0:C}'}" FontSize="14"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
